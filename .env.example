# Vinta School OS — Environment Variables Template
# Copy this file to .env and fill in your values.

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database (MySQL)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/vinta_school_dev
TEST_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/vinta_school_test

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
